const DEFAULT_MAINTENANCE_STAFF: MaintenanceStaffRecord[] = [];

type StoreListener = () => void;

class AdminStore {
  private listeners: Set<StoreListener> = new Set();
  private lastLocalUpdate: Record<string, number> = {};

  constructor() {
    this.initFirestoreSync();
  }

  private initFirestoreSync(): void {
  try {
    // Sync admin_store data
    const keysToSync = [
      STORAGE_KEYS.SETTINGS,
      STORAGE_KEYS.NOTIFICATIONS,
      STORAGE_KEYS.FORMS,
      STORAGE_KEYS.SERVICES,
      STORAGE_KEYS.DOCUMENTS,
      STORAGE_KEYS.TRANSACTIONS,
      STORAGE_KEYS.MAINTENANCE_TASKS,
      STORAGE_KEYS.MAINTENANCE_STAFF,
      STORAGE_KEYS.JOBS,
      STORAGE_KEYS.LOGS,
      STORAGE_KEYS.ADMINS,
    ];

    keysToSync.forEach((key) => {
      onSnapshot(
        doc(db, 'admin_store', key),
        (snapshot) => {
          if (!snapshot.exists()) return;

          const data = snapshot.data();

          if (data && data.value !== undefined) {
            const firestoreTs =
            data.updatedTimestamp ||
            data.updatedAt || 
            0;
            const localTs = this.lastLocalUpdate[key] || 0;

            if (firestoreTs >= localTs) {
              try {
                localStorage.setItem(
                  key,
                  JSON.stringify(data.value)
                );

                this.notify();
              } catch (e) {
                console.warn(
                  `Error applying ${key} snapshot:`,
                  e
                );
              }
            }
          }
        },
        (err) => {
          console.warn(
            `Firestore snapshot error on ${key}:`,
            err
          );
        }
      );
    });

    // IMPORTANT:
    // Real users come from Firestore users collection.
    onSnapshot(
      collection(db, 'users'),
      (snapshot) => {
        console.log('?? FIRESTORE USERS COUNT:', snapshot.size);
        const users: AdminUserRecord[] = snapshot.docs.map(
          (userDoc) => {
            const data = userDoc.data();

           return {
  id: data.sffUserId || data.userId || userDoc.id,
  uid: data.uid || userDoc.id,

  name: data.fullName || data.name || '',
  email: data.email || '',
  mobile: data.mobileNumber || data.mobile || '',

  status:
    data.accountStatus === 'blocked'
      ? 'Blocked'
      : 'Active',

  registrationDate:
    data.createdAt?.toDate?.()?.toISOString?.() ||
    data.createdAt ||
    new Date().toISOString(),

  lastLogin:
    data.lastLogin?.toDate?.()?.toISOString?.() ||
    data.lastLogin ||
    data.updatedAt?.toDate?.()?.toISOString?.() ||
    data.updatedAt ||
    new Date().toISOString(),

  createdDate:
    data.createdAt?.toDate?.()?.toISOString?.() ||
    data.createdAt ||
    new Date().toISOString(),

  lastActive:
    data.updatedAt?.toDate?.()?.toISOString?.() ||
    data.updatedAt ||
    new Date().toISOString(),
} as AdminUserRecord;
          }
        );

        localStorage.setItem(
          STORAGE_KEYS.USERS,
          JSON.stringify(users)
        );

        this.notify();
      },
      (err) => {
        console.warn(
          'Firestore users snapshot error:',
          err
        );
      }
    );

  } catch (e) {
    console.warn(
      'Failed to initialize Firestore adminStore sync:',
      e
    );
  }
}

  private getItem<T>(key: string, defaultValue: T): T {
    try {
      const data = localStorage.getItem(key);
      return data ? JSON.parse(data) : defaultValue;
    } catch {
      return defaultValue;
    }
  }

  private setItem<T>(key: string, value: T): void {
    try {
      const now = Date.now();
      this.lastLocalUpdate[key] = now;
      localStorage.setItem(key, JSON.stringify(value));
      this.notify();
      // Asynchronously sync to Cloud Firestore
      const sanitizedValue = JSON.parse(JSON.stringify(value ?? null));
      setDoc(
        doc(db, 'admin_store', key),
        { value: sanitizedValue, updatedAt: new Date().toISOString(), updatedTimestamp: now },
        { merge: false }
      ).catch((e) => {
        console.warn('Failed to sync adminStore key to Firestore:', key, e);
      });
    } catch (e) {
      console.error('Failed to save to localStorage:', e);
    }
  }

  public subscribe(listener: StoreListener): () => void {
    this.listeners.add(listener);
    return () => this.listeners.delete(listener);
  }

  private notify(): void {
    queueMicrotask(() => {
      this.listeners.forEach((l) => l());
    });
  }

  // --- USERS ---
  public getUsers(): AdminUserRecord[] {
    return this.getItem<AdminUserRecord[]>(STORAGE_KEYS.USERS, []);
  }

  public saveUser(user: AdminUserRecord): void {
  const users = this.getUsers();

  const normalizedId = (user.id || '').trim().toLowerCase();
  const normalizedEmail = (user.email || '').trim().toLowerCase();
  const normalizedMobile = (user.mobile || '').replace(/\D/g, '');

  const index = users.findIndex((u) => {
    const existingId = (u.id || '').trim().toLowerCase();
    const existingEmail = (u.email || '').trim().toLowerCase();
    const existingMobile = (u.mobile || '').replace(/\D/g, '');

    return (
      (normalizedId && existingId === normalizedId) ||
      (normalizedEmail && existingEmail === normalizedEmail) ||
      (normalizedMobile && existingMobile === normalizedMobile)
    );
  });

  if (index >= 0) {
    users[index] = {
      ...users[index],
      ...user,
    };
  } else {
    users.unshift(user);
  }

  this.setItem(STORAGE_KEYS.USERS, users);
}

  public updateUserStatus(userId: string, status: AdminUserRecord['status']): void {
    const users = this.getUsers();
    const updated = users.map((u) => (u.id === userId ? { ...u, status } : u));
    this.setItem(STORAGE_KEYS.USERS, updated);
    this.addLog('User', `Updated status of user ID ${userId} to ${status}`);
  }

  public deleteUser(userId: string): void {
    const targetUser = this.getUsers().find((u) => u.id === userId || u.email === userId || u.mobile === userId);
    const users = this.getUsers().filter((u) => u.id !== userId && u.email !== userId && u.mobile !== userId);
    this.setItem(STORAGE_KEYS.USERS, users);
    this.addLog('User', `Deleted user ID ${userId}`);

    // Permanently remove from Firestore collections and local user caches
    try {
      const keysToDelete = [userId, targetUser?.email, targetUser?.mobile].filter(Boolean) as string[];
      keysToDelete.forEach((key) => {
        deleteDoc(doc(db, 'users', key)).catch(() => {});
        deleteDoc(doc(db, 'user_documents', key)).catch(() => {});
        deleteDoc(doc(db, 'user_profile', key)).catch(() => {});
        const safeKey = key.replace(/[^a-zA-Z0-9_.-]/g, '_').toLowerCase();
        localStorage.removeItem(`sff_user_profile_${safeKey}`);
        localStorage.removeItem(`sff_user_documents_${safeKey}`);
      });
    } catch (e) {
      console.warn('Failed to delete user Firestore documents:', e);
    }
  }

