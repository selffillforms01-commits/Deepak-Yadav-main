  public getTransactions(): TransactionRecord[] {
    const txns = this.getItem<TransactionRecord[]>(STORAGE_KEYS.TRANSACTIONS, []);
    const seen = new Set<string>();
    const cleanTxns: TransactionRecord[] = [];

    txns.forEach((txn) => {
      if (!txn || !txn.id || seen.has(txn.id)) return;
      seen.add(txn.id);
      cleanTxns.push(txn);
    });

    return cleanTxns;
  }

  public saveTransaction(transaction: TransactionRecord): void {
    const txns = this.getTransactions();
    const index = txns.findIndex((t) => t.id === transaction.id);

    if (index >= 0) {
      txns[index] = transaction;
    } else {
      txns.unshift(transaction);
    }

    this.setItem(STORAGE_KEYS.TRANSACTIONS, txns);
  }

  public deleteTransaction(id: string): void {
    const txns = this.getTransactions().filter((t) => t.id !== id);
    this.setItem(STORAGE_KEYS.TRANSACTIONS, txns);
    this.addLog('System', `Deleted transaction ID ${id}`);
  }

  public bulkDeleteTransactions(ids: string[]): void {
    const idSet = new Set(ids);
    const txns = this.getTransactions().filter((t) => !idSet.has(t.id));
    this.setItem(STORAGE_KEYS.TRANSACTIONS, txns);
    this.addLog('System', `Bulk deleted ${ids.length} transaction(s)`);
  }

  public clearAllTransactions(): void {
    this.setItem(STORAGE_KEYS.TRANSACTIONS, []);
    this.addLog('System', 'Cleared all transaction records');
  }

  public deleteTransactionsByType(type: TransactionRecord['type']): void {
    const txns = this.getTransactions().filter((t) => t.type !== type);
    this.setItem(STORAGE_KEYS.TRANSACTIONS, txns);
    this.addLog('System', `Deleted all ${type} transaction records`);
  }

  // --- MAINTENANCE TASKS ---
  public getMaintenanceTasks(): MaintenanceTaskRecord[] {
    const tasks = this.getItem<MaintenanceTaskRecord[]>(
      STORAGE_KEYS.MAINTENANCE_TASKS,
      []
    );

    const forms = this.getForms();

    // Remove legacy User Payment tasks when the same payment already
    // has a corresponding Form Submission task. This cleans up old
    // duplicate tasks created before the duplicate-payment fix.
    const formPaymentIds = new Set(
      forms
        .map((f) => String(
          f.formData?.paymentTransactionId ||
          f.formData?.transactionId ||
          ''
        ).trim())
        .filter(Boolean)
    );

    const cleanedTasks = tasks.filter((t) => {
      if (t.sourceType !== 'User Payment') return true;
      const sourceId = String(t.sourceId || '').trim();
      return !sourceId || !formPaymentIds.has(sourceId);
    });

    if (cleanedTasks.length !== tasks.length) {
      this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, cleanedTasks);
    }

    const existingSourceIds = new Set(
      cleanedTasks.map((t) => t.sourceId).filter(Boolean)
    );

    const autoGenerated: MaintenanceTaskRecord[] = [];

    forms.forEach((f) => {
      const paymentStatus = String(
        f.formData?.paymentStatus || ''
      ).toLowerCase();

      const hasPaymentTracking =
        !!f.formData?.paymentTransactionId ||
        !!f.formData?.utrNumber ||
        !!f.formData?.paymentMethod ||
        f.formData?.feePaid !== undefined;

      // Payment-linked forms enter Maintenance only after Admin verification.
      if (hasPaymentTracking && paymentStatus !== 'completed') {
        return;
      }

      // Do not create another task for an existing form.
      if (
        existingSourceIds.has(f.id) ||
        existingSourceIds.has(f.formNumber)
      ) {
        return;
      }

      autoGenerated.push({
        id: `TASK-F-${f.id}`,
        taskNumber: `MNT-${f.formNumber}`,
        sourceType: 'Form Submission',
        sourceId: f.id,
        title: `Form Processing: ${f.serviceTitle}`,
        applicantName: f.applicantName,
        applicantMobile: f.applicantMobile,
        applicantEmail: f.applicantEmail,
        amount: f.formData?.feePaid || 30,
        status: f.status === 'Approved'
          ? 'Completed'
          : 'Pending Assignment',
        adminRemarks:
          f.remarks ||
          'New application submitted. Ready for form processing.',
        createdDate: f.submissionDate,
        priority: 'High',
      });
    });

    // IMPORTANT:
    // Do NOT create a separate "User Payment" maintenance task.
    // A verified payment already creates/updates its Form.
    // That Form becomes the single Maintenance & Work task.

    if (autoGenerated.length > 0) {
      const merged = [...cleanedTasks, ...autoGenerated];
      this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, merged);
      return merged;
    }

    return tasks;
  }

  public saveMaintenanceTask(task: MaintenanceTaskRecord): void {
    const tasks = this.getItem<MaintenanceTaskRecord[]>(
      STORAGE_KEYS.MAINTENANCE_TASKS,
      []
    );

    const idx = tasks.findIndex(
      (t) => t.id === task.id || t.taskNumber === task.taskNumber
    );

    if (idx >= 0) {
      tasks[idx] = task;
    } else {
      tasks.unshift(task);
    }

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, tasks);
  }

  public bulkAssignMaintenanceTasks(
    taskIds: string[],
    staffId: string,
    staffName: string,
    remarks: string,
    priority: 'High' | 'Medium' | 'Low' = 'High'
  ): void {
    const tasks = this.getMaintenanceTasks();
    const now = new Date().toISOString();

    const updated = tasks.map((t) => {
      if (!taskIds.includes(t.id)) return t;

      return {
        ...t,
        assignedStaffId: staffId,
        assignedStaffName: staffName,
        adminRemarks: remarks
          ? `${t.adminRemarks ? t.adminRemarks + ' | ' : ''}Sent to Maintenance: ${remarks}`
          : t.adminRemarks,
        status: 'Sent to Maintenance' as MaintenanceTaskStatus,
        assignedDate: now,
        priority,
      };
    });

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, updated);

    this.saveNotification({
      id: `NOTIF-MNT-${Date.now()}`,
      title: `${taskIds.length} Task(s) Assigned to Maintenance Staff`,
      message:
        `Admin assigned ${taskIds.length} work item(s) to ${staffName}. ` +
        `Remark: "${remarks || 'Sent to Maintenance'}".`,
      targetAudience: 'Admins Only',
      priority: 'High',
      sentDate: now,
      status: 'Sent',
      createdBy: 'Super Admin',
    });

    this.addLog(
      'System',
      `Assigned ${taskIds.length} maintenance task(s) to ${staffName}`
    );
  }

  public updateMaintenanceTaskStatus(
    taskId: string,
    status: MaintenanceTaskStatus,
    staffRemarks?: string
  ): void {
    const tasks = this.getMaintenanceTasks();

    const updated = tasks.map((t) => {
      if (t.id !== taskId) return t;

      return {
        ...t,
        status,
        staffRemarks: staffRemarks || t.staffRemarks,
        completedDate:
          status === 'Completed'
            ? new Date().toISOString()
            : t.completedDate,
      };
    });

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, updated);
    this.addLog(
      'System',
      `Updated maintenance task ${taskId} status to "${status}"`
    );
  }

  public deleteMaintenanceTask(id: string): void {
    const tasks = this.getMaintenanceTasks().filter(
      (t) => t.id !== id
    );

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, tasks);
    this.addLog('System', `Deleted maintenance task ID ${id}`);
  }

  public bulkDeleteMaintenanceTasks(ids: string[]): void {
    const tasks = this.getMaintenanceTasks().filter(
      (t) => !ids.includes(t.id)
    );

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, tasks);
    this.addLog(
      'System',
      `Bulk deleted ${ids.length} maintenance tasks`
    );
  }

  public clearDemoMaintenanceTasks(): void {
    const tasks = this.getMaintenanceTasks().filter(
      (t) =>
        t.sourceType === 'Form Submission' ||
        t.sourceType === 'User Payment'
    );

    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, tasks);
    this.addLog(
      'System',
      'Cleared demo/system maintenance tasks'
    );
  }

  public clearAllMaintenanceTasks(): void {
    this.setItem(STORAGE_KEYS.MAINTENANCE_TASKS, []);
    this.addLog('System', 'Cleared all maintenance tasks');
  }

  // --- MAINTENANCE STAFF ---
  public getMaintenanceStaff(): MaintenanceStaffRecord[] {
    return this.getItem<MaintenanceStaffRecord[]>(
      STORAGE_KEYS.MAINTENANCE_STAFF,
      []
    );
  }

  public saveMaintenanceStaff(
    staff: MaintenanceStaffRecord
  ): void {
    const staffList = this.getMaintenanceStaff();

    const index = staffList.findIndex(
      (s) => s.id === staff.id || s.username === staff.username
    );

    if (index >= 0) {
      staffList[index] = staff;
    } else {
      staffList.unshift(staff);
    }

    this.setItem(
      STORAGE_KEYS.MAINTENANCE_STAFF,
      staffList
    );
  }

  public deleteMaintenanceStaff(id: string): void {
    const staffList = this.getMaintenanceStaff().filter(
      (s) => s.id !== id
    );

    this.setItem(
      STORAGE_KEYS.MAINTENANCE_STAFF,
      staffList
    );

    this.addLog(
      'Security',
      `Deleted maintenance staff ID ${id}`
    );
  }

  public validateMaintenanceStaffLogin(
    username: string,
    password: string
  ): MaintenanceStaffRecord | null {
    const staff = this.getMaintenanceStaff();

    const matched = staff.find(
      (s) =>
        s.username === username &&
        s.password === password &&
        s.status !== 'Offline'
    );

    return matched || null;
  }
  // --- LOGS ---
  public getLogs(): AdminActivityLog[] {
    return this.getItem<AdminActivityLog[]>(STORAGE_KEYS.LOGS, []);
  }

  public addLog(
    category: AdminActivityLog['category'],
    details: string,
    adminName: string = 'Super Admin',
    adminEmail: string = 'admin@sff.gov.in'
  ): void {
    const logs = this.getLogs();
    const newLog: AdminActivityLog = {
      id: `LOG-${Date.now()}`,
      timestamp: new Date().toISOString(),
      adminName,
      adminEmail,
      action: details,
      category,
      details,
      ipAddress: '192.168.1.1',
    };
    logs.unshift(newLog);
    // limit to 100 logs
    if (logs.length > 100) logs.pop();
    this.setItem(STORAGE_KEYS.LOGS, logs);
  }

  public clearLogs(): void {
    this.setItem(STORAGE_KEYS.LOGS, []);
  }

  public clearTotalDatabase(): void {
    try {
      Object.values(STORAGE_KEYS).forEach((key) => {
        localStorage.removeItem(key);
        try {
          setDoc(
  doc(db, 'admin_store', key),
  {
    value: [],
    updatedAt: new Date().toISOString(),
    updatedTimestamp: Date.now(),
  }
).catch(() => {});

        } catch (e) {
          // ignore
        }
      });
      localStorage.removeItem('sff_logged_user');
      localStorage.removeItem('sff_user');
      localStorage.removeItem('sff_auth');
      localStorage.removeItem('sff_user_documents');
      localStorage.removeItem('sff_current_user_profile');
      this.notify();
      this.addLog('System', 'TOTAL DATABASE WIPED: All users, forms, documents, and records deleted successfully.');
    } catch (e) {
      console.error('Failed to wipe database:', e);
    }
  }
}

export const adminStore = new AdminStore();










