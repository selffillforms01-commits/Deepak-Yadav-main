  public deleteDocument(docId: string): void {
    const docs = this.getDocuments().filter((d) => d.id !== docId);
    this.setItem(STORAGE_KEYS.DOCUMENTS, docs);
    this.addLog('Document', `Deleted document ID ${docId}`);
  }

  public updateDocumentStatus(docId: string, status: AdminDocumentRecord['status']): void {
    const docs = this.getDocuments();
    const updated = docs.map((d) => (d.id === docId ? { ...d, status } : d));
    this.setItem(STORAGE_KEYS.DOCUMENTS, updated);
    this.addLog('Document', `Updated status of document ID ${docId} to ${status}`);
  }

  // --- SERVICES ---
  public getServices(): AdminServiceRecord[] {
    const services = this.getItem<AdminServiceRecord[]>(STORAGE_KEYS.SERVICES, []);
    let list = services;
    if (!list || list.length === 0) {
      list = DEFAULT_SERVICES;
    }
    // Deduplicate by ID and Title
    const seen = new Set<string>();
    const cleanList: AdminServiceRecord[] = [];
    list.forEach((s) => {
      const key = (s.title || s.id || '').trim().toLowerCase();
      if (key && !seen.has(key)) {
        seen.add(key);
        cleanList.push(s);
      }
    });
    return cleanList;
  }

  public resetDefaultServices(): void {
    this.setItem(STORAGE_KEYS.SERVICES, DEFAULT_SERVICES);
    this.addLog('Service', 'Reset catalog to default system services');
  }

  public saveService(service: AdminServiceRecord): void {
    const services = this.getServices();
    const index = services.findIndex((s) => s.id === service.id);
    if (index >= 0) {
      services[index] = service;
      this.addLog('Service', `Updated service "${service.title}"`);
    } else {
      services.unshift(service);
      this.addLog('Service', `Created new service "${service.title}"`);
    }
    this.setItem(STORAGE_KEYS.SERVICES, services);
  }

  public deleteService(serviceId: string): void {
    const services = this.getServices();
    const target = services.find((s) => s.id === serviceId);
    const filtered = services.filter((s) => s.id !== serviceId);
    this.setItem(STORAGE_KEYS.SERVICES, filtered);
    if (target) {
      this.addLog('Service', `Deleted service "${target.title}"`);
    }
  }

  public toggleServiceStatus(serviceId: string): void {
    const services = this.getServices();
    const updated = services.map((s) =>
      s.id === serviceId ? { ...s, enabled: !s.enabled } : s
    );
    this.setItem(STORAGE_KEYS.SERVICES, updated);
    this.addLog('Service', `Toggled availability status of service ID ${serviceId}`);
  }

  // --- JOBS ---
  public getJobs(): AdminJobRecord[] {
    const jobs = this.getItem<AdminJobRecord[]>(
      STORAGE_KEYS.JOBS,
      []
    );

    return jobs
      .filter((job) => job && job.id)
      .sort((a, b) => {
        const dateA = new Date(a.lastDate).getTime() || 0;
        const dateB = new Date(b.lastDate).getTime() || 0;
        return dateA - dateB;
      });
  }

  public saveJob(job: AdminJobRecord): void {
    const jobs = this.getJobs();
    const index = jobs.findIndex((j) => j.id === job.id);

    const updatedJob: AdminJobRecord = {
      ...job,
      updatedDate: new Date().toISOString(),
    };

    if (index >= 0) {
      jobs[index] = updatedJob;
      this.addLog('Service', `Updated job "${job.title}"`);
    } else {
      jobs.unshift(updatedJob);
      this.addLog('Service', `Created new job "${job.title}"`);
    }

    this.setItem(STORAGE_KEYS.JOBS, jobs);
  }

  public deleteJob(jobId: string): void {
    const jobs = this.getJobs();
    const target = jobs.find((job) => job.id === jobId);

    const filteredJobs = jobs.filter(
      (job) => job.id !== jobId
    );

    this.setItem(STORAGE_KEYS.JOBS, filteredJobs);

    if (target) {
      this.addLog('Service', `Deleted job "${target.title}"`);
    }
  }

  public toggleJobStatus(jobId: string): void {
    const jobs = this.getJobs();

    const updatedJobs = jobs.map((job) =>
      job.id === jobId
        ? {
            ...job,
            status:
              job.status === 'Active'
                ? 'Inactive'
                : 'Active',
            updatedDate: new Date().toISOString(),
          }
        : job
    );

    this.setItem(STORAGE_KEYS.JOBS, updatedJobs);

    const target = jobs.find(
      (job) => job.id === jobId
    );

    if (target) {
      this.addLog(
        'Service',
        `Toggled job "${target.title}" status`
      );
    }
  }
  // --- FORMS ---
  public getForms(): AdminFormRecord[] {
    const forms = this.getItem<AdminFormRecord[]>(STORAGE_KEYS.FORMS, []);
    const seen = new Set<string>();
    const cleanForms: AdminFormRecord[] = [];
    forms.forEach((f) => {
      const key = f.id || f.formNumber;
      if (key && !seen.has(key)) {
        seen.add(key);
        cleanForms.push(f);
      }
    });
    return cleanForms.sort((a, b) => {
      const timeA = new Date(a.submissionDate).getTime() || 0;
      const timeB = new Date(b.submissionDate).getTime() || 0;
      return timeB - timeA;
    });
  }

  public saveForm(form: AdminFormRecord): void {
    const forms = this.getForms();
    const index = forms.findIndex((f) => f.id === form.id || f.formNumber === form.formNumber);
    if (index >= 0) {
      forms[index] = form;
    } else {
      forms.unshift(form);
    }
    this.setItem(STORAGE_KEYS.FORMS, forms);
  }

  public updateFormStatus(
  formId: string,
  status: AdminFormRecord['status'],
  remarks?: string,
  reviewedBy: string = 'Super Admin'
): void {
  const forms = this.getForms();

  const matchedForm = forms.find((f) => f.id === formId);

  if (!matchedForm) return;

  const updated = forms.map((f) =>
    f.id === formId
      ? {
          ...f,
          status,
          remarks: remarks || f.remarks,
          reviewedBy,
          reviewedAt: new Date().toISOString(),
        }
      : f
  );

  this.setItem(STORAGE_KEYS.FORMS, updated);
  this.addLog('Form', `Form #${formId} set to status "${status}"`);

  const recipient =
    matchedForm.applicantEmail ||
    matchedForm.applicantMobile ||
    matchedForm.applicantId;

  this.saveNotification({
    id: `NTF-STATUS-${Date.now()}`,
    title: `?? Application Status Update: ${matchedForm.serviceTitle || 'Form Submission'}`,
    message: `Admin (${reviewedBy}) has updated your application #${matchedForm.formNumber || formId} status to "${status}". ${
      remarks ? `Admin Remarks: "${remarks}"` : ""
    }`,
    notificationType: "Application Status",
    targetAudience: "Selected Users",
    targetMode: "Single User",
    targetValue: recipient,
    priority: status === "Approved" ? "High" : "Medium",
    sentDate: new Date().toISOString(),
    status: "Sent",
    createdBy: reviewedBy,
  });
}
  public deleteForm(formId: string): void {
    const forms = this.getForms().filter((f) => f.id !== formId);
    this.setItem(STORAGE_KEYS.FORMS, forms);
    this.addLog('Form', `Deleted form submission ID ${formId}`);

    deleteDoc(doc(db, 'forms', formId)).catch(() => {});
    deleteDoc(doc(db, 'form_requests', formId)).catch(() => {});
  }

  public bulkDeleteForms(formIds: string[]): void {
    const idSet = new Set(formIds);
    const forms = this.getForms().filter((f) => !idSet.has(f.id));
    this.setItem(STORAGE_KEYS.FORMS, forms);
    this.addLog('Form', `Bulk deleted ${formIds.length} form submission(s)`);

    formIds.forEach((id) => {
      deleteDoc(doc(db, 'forms', id)).catch(() => {});
      deleteDoc(doc(db, 'form_requests', id)).catch(() => {});
    });
  }

